# Copy to .env at the repo root (same directory as docker-compose.prod.yml).
# docker compose auto-loads this for the ${VAR} interpolation in that file.
# Never commit the real .env.
#
# POSTGRES_PASSWORD and NEO4J_PASSWORD here must match the values you put
# in apps/api/.env's DATABASE_URL / NEO4J_PASSWORD — see docs/deployment.md.

POSTGRES_USER=cip
POSTGRES_PASSWORD=replace_with_a_generated_secret
POSTGRES_DB=cip
NEO4J_PASSWORD=replace_with_a_different_generated_secret

# Real domain for automatic HTTPS (e.g. staging.example.com), or
# http://<server-ip> for plain HTTP if you don't have a domain yet.
SITE_ADDRESS=staging.example.com
