# Copy to apps/api/.env for staging/prod. Never commit the real .env.
#
# POSTGRES_PASSWORD / NEO4J_PASSWORD below must match the same-named
# values in the repo-root .env (docker-compose.prod.yml) — see
# docs/deployment.md.

# Postgres — user/db/password must match the repo-root .env
DATABASE_URL=postgresql+psycopg2://cip:replace_with_a_generated_secret@postgres:5432/cip

# Neo4j — password must match the repo-root .env
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_a_different_generated_secret

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_generated_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_INACTIVITY_EXPIRE_MINUTES=15

# App
ENVIRONMENT=staging
# Must be the exact origin(s) the frontend is served from (scheme + host,
# no path, no trailing slash) — browsers reject the credentialed requests
# this app makes if this doesn't match exactly.
CORS_ORIGINS=https://staging.example.com
