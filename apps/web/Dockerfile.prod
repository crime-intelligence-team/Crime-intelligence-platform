# Build context is the repo root (see docker-compose.prod.yml) because the
# app resolves @cip/shared-types straight to source via a Vite path alias,
# not an installed package — the build stage needs both directories.

FROM node:20-slim AS build
WORKDIR /repo
COPY packages/shared-types ./packages/shared-types
COPY apps/web ./apps/web
WORKDIR /repo/apps/web
RUN npm ci
RUN npm run build

FROM caddy:2-alpine
COPY infra/docker/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /repo/apps/web/dist /srv
